<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">
    <changeSet id="translate-some-comments" author="adel">
        <setTableRemarks tableName="gc_user_access" remarks="Mapping between content groups and assigned courses"/>
    </changeSet>
    <changeSet id="create-content_group_course_assignment" author="vprokh">
        <createTable tableName="gc_content_group_course_assignment"
                     remarks="Table is responsible for establishing relation between content group, course assigned to it and user who made the assignment">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="course_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="access_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="is_mandatory" type="tinyint" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="gc_content_group_course_assignment_gc_access_id_fk"
                                 baseTableName="gc_content_group_course_assignment" baseColumnNames="access_id"
                                 referencedTableName="gc_access" referencedColumnNames="id"
                                 onUpdate="CASCADE"/>

        <addForeignKeyConstraint constraintName="gc_content_group_course_assignment_gc_subject_id_fk"
                                 baseTableName="gc_content_group_course_assignment" baseColumnNames="course_id"
                                 referencedTableName="gc_subject" referencedColumnNames="id"
                                 onUpdate="CASCADE" onDelete="CASCADE"/>

        <addForeignKeyConstraint constraintName="gc_content_group_course_assignment_gc_user_id_fk"
                                 baseTableName="gc_content_group_course_assignment" baseColumnNames="user_id"
                                 referencedTableName="gc_user" referencedColumnNames="id"
                                 onUpdate="CASCADE"/>
    </changeSet>

</databaseChangeLog>
