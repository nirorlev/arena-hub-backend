<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.threeatom.guidecore.mapper.GcUserEventMapper">
  <sql id="base_column_list">
       id   ,  user_id   ,  event_id,master_id
  </sql>

    <insert id="insertBatch" parameterType="java.util.List">
    insert into gc_user_event ( <include refid="base_column_list" /> )
    values
    <foreach collection="userEvents" item="item" index="index" separator="," >
    (  #{item.id}  , #{item.userId}  , #{item.eventId},#{item.masterId})
  	</foreach>
  </insert>
    <select id="selectUserEvents" resultType="java.util.Map">
      select event_id as eventId ,GROUP_CONCAT(user_id SEPARATOR ',') as userList from gc_user_event
        where
      event_id in
      <foreach collection="list" item="list" index="index" separator="," open="(" close=")" >
        #{list}
      </foreach>
      GROUP BY event_id
    </select>


</mapper>