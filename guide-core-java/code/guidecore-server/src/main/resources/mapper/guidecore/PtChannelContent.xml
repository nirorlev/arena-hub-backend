<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.threeatom.guidecore.mapper.PtchannelContentMapper">

    <resultMap id="baseResultMap" type="com.threeatom.guidecore.entity.PtChannelContent">
        <id property="id" column="id"/>
        <result property="channelId" column="channel_id"  />
        <result property="videoId" column="video_id"  />
        <result property="playlistId" column="playlist_id"  />
        <result property="sectionId" column="section_id"  />
        <result property="contentOrder" column="order"  />
        <result property="videoThumbNailUrl" column="videoThumbNailUrl"/>
    </resultMap>

    <resultMap id="channelMap" type="com.threeatom.guidecore.entity.PtChannel">
        <id property="id" column="id"/>
        <result property="channelName" column="channel_name"  />
        <result property="channelImgFileId" column="channel_imgid"  />
        <result property="desc" column="channel_desc"  />
        <result property="createUserId" column="channel_createuserid"  />
        <result property="visibleFlag" column="channel_vf"  />
        <result property="categoryId" column="channel_ci"/>
        <result property="level" column="channel_level"/>
        <result property="fid" column="channel_fid"/>
        <result property="order" column="channel_order"/>
        <result property="masterId" column="channel_masterid"/>
        <collection property="sectionList" javaType="ArrayList" column="id" ofType="com.threeatom.guidecore.entity.PtChannel">
            <id property="id" column="section_id" />
            <result property="channelName" column="section_name"  />
            <result property="channelImgFileId" column="section_imgid"  />
            <result property="desc" column="section_desc"  />
            <result property="createUserId" column="section_createuserid"  />
            <result property="visibleFlag" column="section_vf"  />
            <result property="categoryId" column="section_ci"/>
            <result property="level" column="section_level"/>
            <result property="fid" column="section_fid"/>
            <result property="order" column="section_order"/>
            <result property="masterId" column="section_masterid"/>
            <collection property="videoList" javaType="ArrayList" column="id" ofType="com.threeatom.system.entity.SysFile">
                <id property="id" column="file_id" />
                <result property="name" column="video_f_name"/>
                <result property="fileUrl" column="video_file_url"/>
                <result property="saveType" column="video_f_save_type"/>
                <result property="fileTypeIndex" column="video_f_file_index"/>
                <result property="fileType" column="video_f_file_type"/>
                <result property="thumbNailId" column="thumb_nail_id"/>
                <result property="thumbNailUrl" column="thumb_nail_url"/>
            </collection>
        </collection>

    </resultMap>

    <select id="selectVideosInChannel" resultType="com.threeatom.system.entity.SysFile">
        select video.*,content.id as ptChannelContentId ,
        coalesce((select count(1) from gc_user_video_action where file_id=video.id and type=1),0) as likeNum from sys_file video
        left join pt_channel_content content on content.file_id = video.id
        where content.channel_id =#{channelId}
        group by video.id
        <choose>
            <when test="order!=null">
                order by convert_to(video.name, 'UTF8') ${order}
            </when>
            <otherwise>
                order by content.content_order asc
            </otherwise>
        </choose>
    </select>

    <select id="selectSectionVideos" resultMap="channelMap">
        select channel.id as id,channel.channel_name as channel_name,channel.channel_img_file_id as channel_imgid,channel.desc as channel_desc,
        channel.create_user_id as channel_createuserid,channel.visible_flag as channel_vf,channel.category_id as channel_ci,channel.level as channel_level,
        channel.fid as channel_fid,channel.order as channel_order,channel.master_id as channel_masterid,video.video_name as gcVideo_videoName,
        video.video_desc as gcVideo_videoDesc,video.file_id as video_file_id
        from pt_channel channel
        left join pt_channel_content content on content.channel_id = channel.id
        left join gc_video video on video.id = content.video_id
        left join sys_file sysFile on sysFile.id = video.file_ie
    </select>


</mapper>
