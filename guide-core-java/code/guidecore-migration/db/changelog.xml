<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="add-video-play-session" author="vprokh">
        <createTable tableName="video_play_session">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="video_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="master_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="video_play_session_gc_user_id_fk" baseTableName="video_play_session"
                                 baseColumnNames="user_id" referencedTableName="gc_user" referencedColumnNames="id"
                                 onUpdate="CASCADE"/>
        <addForeignKeyConstraint constraintName="video_play_session_gc_master_id_fk" baseTableName="video_play_session"
                                 baseColumnNames="master_id" referencedTableName="gc_master" referencedColumnNames="id"
                                 onUpdate="CASCADE"/>
        <addForeignKeyConstraint constraintName="video_play_session_gc_video_id_fk" baseTableName="video_play_session"
                                 baseColumnNames="video_id" referencedTableName="gc_video" referencedColumnNames="id"
                                 onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="add-video-play-segment" author="vprokh">
        <createTable tableName="video_play_segment">
            <column name="segment_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="session_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="segment" type="int4range">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey constraintName="video_play_segment_pk" columnNames="segment_id, session_id"
                       tableName="video_play_segment"/>
        <addForeignKeyConstraint constraintName="video_play_segment_video_play_session_id_fk"
                                 baseTableName="video_play_segment" baseColumnNames="session_id"
                                 referencedTableName="video_play_session" referencedColumnNames="id" onUpdate="CASCADE"
                                 onDelete="CASCADE"/>
    </changeSet>
    <changeSet id="create-comments-playlist-feature-toggle" author="vprokh">
        <insert tableName="feature_toggle">
            <column name="name" value="commentsPlaylistEnabled"/>
            <column name="description" value="Feature toggle for showing or hiding comments for playlist"/>
            <column name="value" value="false"/>
        </insert>
    </changeSet>
    <changeSet id="create-comments-channel-feature-toggle" author="vprokh">
        <insert tableName="feature_toggle">
            <column name="name" value="commentsChannelEnabled"/>
            <column name="description" value="Feature toggle for showing or hiding comments for channel"/>
            <column name="value" value="false"/>
        </insert>
    </changeSet>
    <changeSet id="test-migration-schema" author="vprokh">
        <createTable tableName="test_migration">
            <column name="id" type="uuid"/>
        </createTable>
    </changeSet>
    <changeSet id="create-homepage-menu-feature-toggle" author="vprokh">
        <insert tableName="feature_toggle">
            <column name="name" value="homepageMenuEnabled"/>
            <column name="description" value="Feature toggle for showing or hiding homepage"/>
            <column name="value" value="false"/>
        </insert>
    </changeSet>

    <changeSet id="create-course-content-table" author="vprokh">
        <createTable tableName="course_content">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="course_id" type="integer"/>
            <column name="content_id" type="integer"/>
            <column name="order" type="integer" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="course_content_gc_subject_id_fk" baseTableName="course_content"
                                 baseColumnNames="course_id" referencedTableName="gc_subject" referencedColumnNames="id"
                                 onUpdate="CASCADE"/>
        <addForeignKeyConstraint constraintName="course_content_gc_video_id_fk" baseTableName="course_content"
                                 baseColumnNames="content_id" referencedTableName="gc_video" referencedColumnNames="id"
                                 onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="add-content-columns" author="vprokh">
        <addColumn tableName="gc_video">
            <column name="thumbnail_url" type="text"/>
        </addColumn>
        <addColumn tableName="pt_channel_content">
            <column name="content_id" type="integer"/>
        </addColumn>
        <addColumn tableName="gc_user_save_content">
            <column name="content_id" type="integer"/>
        </addColumn>
    </changeSet>

    <changeSet id="migrate-video-content" author="vprokh">
        <preConditions>
            <rowCount tableName="course_content" expectedRows="0"/>
        </preConditions>
        <sql>
            UPDATE gc_video
            SET thumbnail_url = sys_file.thumb_nail_url,
                video_time    = coalesce(sys_file.video_long, 0) FROM sys_file
            WHERE gc_video.file_id = sys_file.id;

            INSERT INTO course_content (course_id, content_id, "order")
            SELECT sub_id, id, "order"
            FROM gc_video;

            INSERT INTO gc_video (video_name, video_desc, video_time, file_id, thumbnail_url)
            SELECT sys_file.name,
                   sys_file.description,
                   coalesce(sys_file.video_long, 0) as video_long,
                   sys_file.id,
                   sys_file.thumb_nail_url
            FROM sys_file
                     JOIN pt_channel_content ON sys_file.id = pt_channel_content.file_id;

            UPDATE pt_channel_content
            SET content_id = gc_video.id FROM gc_video
            WHERE gc_video.file_id = pt_channel_content.file_id;

            UPDATE gc_user_save_content
            SET content_id = video_id;

            UPDATE gc_user_save_content
            SET content_id = gc_video.id FROM gc_video
            WHERE gc_video.file_id = gc_user_save_content.file_id;
        </sql>

        <addNotNullConstraint tableName="pt_channel_content" columnName="content_id"/>
        <addForeignKeyConstraint baseTableName="pt_channel_content" baseColumnNames="content_id"
                                 constraintName="pt_channel_content_gc_video_id_fk" referencedTableName="gc_video"
                                 referencedColumnNames="id" onUpdate="CASCADE"/>
        <addForeignKeyConstraint baseTableName="gc_user_save_content" baseColumnNames="content_id"
                                 constraintName="gc_user_save_content_gc_video_id_fk" referencedTableName="gc_video"
                                 referencedColumnNames="id" onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="add-login-config-s2s-fields" author="cvmcosta">
        <addColumn tableName="pt_login_config">
            <column name="video_service_client_id" type="varchar(255)"/>
        </addColumn>
        <addColumn tableName="pt_login_config">
            <column name="video_service_secret" type="varchar(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
