    <changeSet id="migrate-origin-id-columns" author="vprokh">
        <sql>
            -- Remove sections that have no connected channel
            DELETE
            FROM pt_channel
            WHERE pt_channel.fid IN (SELECT DISTINCT section.fid
                                     FROM pt_channel section
                LEFT JOIN pt_channel channel
            on channel.id = section.fid
            WHERE channel.id IS NULL AND section.fid IS NOT NULL);

            UPDATE gc_video
            SET origin_channel_id = CASE WHEN pt_channel.fid IS NULL THEN pt_channel.id ELSE pt_channel.fid END FROM pt_channel_content
                JOIN pt_channel
            ON pt_channel_content.channel_id = pt_channel.id
            WHERE pt_channel_content.content_id = gc_video.id;

            -- Remove topics that have no connected course
            DELETE
            FROM gc_subject
            WHERE gc_subject.sub_id IN (SELECT DISTINCT topic.sub_id
                                        FROM gc_subject topic
                                                 LEFT JOIN gc_subject course on course.id = topic.sub_id
                                        WHERE course.id IS NULL
                                          AND topic.sub_id IS NOT NULL);
            UPDATE gc_video
            SET origin_course_id = CASE WHEN gc_subject.sub_id IS NULL THEN gc_subject.id ELSE gc_subject.sub_id END FROM course_content
                JOIN gc_subject
            ON course_content.course_id = gc_subject.id
            WHERE course_content.content_id = gc_video.id;

            -- delete videos that are not referenced neither from the channel or course
            DELETE
            FROM gc_video
            WHERE origin_channel_id IS NULL
              AND origin_course_id IS NULL;

            ALTER TABLE gc_video
                ADD CONSTRAINT chk_origin_channel_id_origin_course_id CHECK ((origin_channel_id IS NULL) &lt;&gt; (origin_course_id IS NULL));
        </sql>
    </changeSet>

