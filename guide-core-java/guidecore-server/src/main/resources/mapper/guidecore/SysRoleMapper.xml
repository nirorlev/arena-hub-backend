<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.threeatom.system.mapper.SysRoleMapper">


    <select id="queryRolesByUid" parameterType="Integer" resultType="SysRole">
        
        select r.* from sys_user_role ur,sys_role r where ur.user_id=#{uid} and ur.role_id=r.id
        
    </select>

</mapper>
