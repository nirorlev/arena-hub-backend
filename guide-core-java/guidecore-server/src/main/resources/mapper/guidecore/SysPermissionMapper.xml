<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.threeatom.system.mapper.SysPermissionMapper">


    <select id="queryEntityByUid" parameterType="Integer" resultType="SysPermission">
        select p.* from sys_user_role r,sys_permission p where r.role_id=p.role_id and r.user_id=#{uid}
    </select>
</mapper>
